{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/okisdev/claude-code-fusion/bench/schema/run-record.schema.json",
  "title": "Benchmark run record",
  "description": "One JSON object per line in bench/results/<date>-<version>/runs.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "taskId",
    "condition",
    "repetition",
    "startedAt",
    "finishedAt",
    "taskManifestHash",
    "conditionNotes",
    "claudeExit",
    "verifyExit",
    "wallClockSeconds",
    "verdict",
    "infraFailure",
    "claudeTokens",
    "peerTokens",
    "peerDefaults",
    "delegationCount",
    "resumeCount",
    "escalationCount",
    "excluded",
    "excludedReason"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "enum": ["A", "B1", "B2", "B3"]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "taskManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conditionNotes": {
      "$ref": "#/$defs/conditionNotes"
    },
    "claudeExit": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "verifyExit": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "wallClockSeconds": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "infra_failure"]
    },
    "infraFailure": {
      "oneOf": [
        {
          "$ref": "#/$defs/infraFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "claudeTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "subagents", "byModel"],
      "properties": {
        "orchestrator": {
          "$ref": "#/$defs/tokenCounts"
        },
        "subagents": {
          "$ref": "#/$defs/tokenCounts"
        },
        "byModel": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tokenCounts"
          }
        }
      }
    },
    "peerTokens": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["grok", "codex"],
          "properties": {
            "grok": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "codex": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "peerDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grok", "codex"],
      "properties": {
        "grok": {
          "$ref": "#/$defs/peerEngineDefaults"
        },
        "codex": {
          "$ref": "#/$defs/peerEngineDefaults"
        }
      }
    },
    "delegationCount": {
      "type": "integer",
      "minimum": 0
    },
    "resumeCount": {
      "type": "integer",
      "minimum": 0
    },
    "escalationCount": {
      "type": "integer",
      "minimum": 0
    },
    "excluded": {
      "type": "boolean"
    },
    "excludedReason": {
      "type": ["string", "null"],
      "enum": [
        "network_outage_all_conditions",
        "harness_defect",
        "external_service_outage",
        null
      ]
    }
  },
  "$defs": {
    "conditionNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "installedPlugins", "enabledPlugins", "routingRulesPresent", "mainSessionModel"],
      "properties": {
        "detection": {
          "type": "string",
          "enum": ["configuration"]
        },
        "installedPlugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "enabledPlugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "routingRulesPresent": {
          "type": "boolean"
        },
        "mainSessionModel": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "infraFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "missing_transcript",
            "ambiguous_transcript",
            "claude_start_failure",
            "verifier_start_failure",
            "task_setup_failure",
            "runner_failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokenCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheCreation"],
      "properties": {
        "input": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "number",
          "minimum": 0
        },
        "cacheRead": {
          "type": "number",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "peerEngineDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "effort": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
