+++ b/concurrent.js
@@ -0,0 +1,41 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  const count = items.length;
+  if (count === 0) {
+    return Promise.resolve([]);
+  }
+
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(app_error("INVALID_LIMIT", "Worker limit must be a positive integer"));
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(count);
+    let next_index = 0;
+    let completed = 0;
+    let failed = false;
+
+    function start_worker() {
+      const index = next_index++;
+      Promise.resolve().then(() => worker(items[index])).then((result) => {
+        if (failed) return;
+
+        results[index] = result;
+        completed += 1;
+        if (completed === count) {
+          resolve(results);
+        } else if (next_index < count) {
+          start_worker();
+        }
+      }, (error) => {
+        failed = true;
+        reject(error);
+      });
+    }
+
+    for (let slot = 0; slot < Math.min(limit, count); slot += 1) {
+      start_worker();
+    }
+  });
+}
diff --git a/retry.js b/retry.js
