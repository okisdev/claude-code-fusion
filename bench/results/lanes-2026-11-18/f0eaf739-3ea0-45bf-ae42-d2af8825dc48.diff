index 0000000..d833828
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,58 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  const item_count = items.length;
+  if (item_count === 0) {
+    return Promise.resolve([]);
+  }
+
+  const worker_count = Math.min(item_count, Math.floor(limit));
+  if (!(worker_count >= 1)) {
+    return Promise.reject(
+      app_error("INVALID_CONCURRENCY_LIMIT", "Concurrency limit must allow at least one worker"),
+    );
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(item_count);
+    let next_index = 0;
+    let remaining = item_count;
+    let failed = false;
+
+    function start_next() {
+      if (failed || next_index === item_count) {
+        return;
+      }
+
+      const index = next_index;
+      next_index += 1;
+
+      let outcome;
+      try {
+        outcome = worker(items[index]);
+      } catch (error) {
+        outcome = Promise.reject(error);
+      }
+
+      Promise.resolve(outcome).then(
+        (result) => {
+          results[index] = result;
+          remaining -= 1;
+          if (remaining === 0) {
+            resolve(results);
+          } else {
+            start_next();
+          }
+        },
+        (error) => {
+          failed = true;
+          reject(error);
+        },
+      );
+    }
+
+    for (let slot = 0; slot < worker_count; slot += 1) {
+      start_next();
+    }
+  });
+}
