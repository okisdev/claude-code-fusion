index 0000000..d834f2a
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,55 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(
+      app_error("INVALID_LIMIT", "Concurrency limit must be a positive integer."),
+    );
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(items.length);
+    let next_index = 0;
+    let remaining = items.length;
+    let failed = false;
+
+    function run_next() {
+      if (failed || next_index === items.length) {
+        return;
+      }
+
+      const index = next_index++;
+
+      Promise.resolve()
+        .then(() => worker(items[index]))
+        .then(
+          (result) => {
+            if (failed) {
+              return;
+            }
+
+            results[index] = result;
+            remaining -= 1;
+
+            if (remaining === 0) {
+              resolve(results);
+            } else {
+              run_next();
+            }
+          },
+          (error) => {
+            failed = true;
+            reject(error);
+          },
+        );
+    }
+
+    for (let index = 0; index < Math.min(limit, items.length); index += 1) {
+      run_next();
+    }
+  });
+}
diff --git a/retry.js b/retry.js
