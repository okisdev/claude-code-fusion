--- /dev/null
+++ b/retry.js
@@ -0,0 +1,19 @@
+import { app_error } from './errors.js';
+import { delay_ms } from './util.js';
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (!Number.isInteger(attempts) || attempts < 1) {
+    return Promise.reject(app_error('INVALID_ATTEMPTS', 'attempts must be a positive integer'));
+  }
+
+  function run(remaining, delay) {
+    return Promise.resolve().then(operation).catch((failure) => {
+      if (remaining === 1) {
+        return Promise.reject(app_error('RETRY_EXHAUSTED', failure?.message ?? String(failure)));
+      }
+      return delay_ms(delay).then(() => run(remaining - 1, delay * 2));
+    });
+  }
+
+  return run(attempts, base_delay_ms);
+}
