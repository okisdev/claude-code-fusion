+++ b/concurrent.js
@@ -0,0 +1,41 @@
+import { app_error } from './errors.js';
+
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(app_error('INVALID_LIMIT', 'limit must be a positive integer'));
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(items.length);
+    let next_index = 0;
+    let active = 0;
+    let completed = 0;
+    let settled = false;
+
+    function start_workers() {
+      while (!settled && active < limit && next_index < items.length) {
+        const index = next_index++;
+        active++;
+        Promise.resolve().then(() => worker(items[index], index)).then((result) => {
+          active--;
+          results[index] = result;
+          completed++;
+          if (completed === items.length) {
+            settled = true;
+            resolve(results);
+          } else {
+            start_workers();
+          }
+        }, (error) => {
+          settled = true;
+          reject(error);
+        });
+      }
+    }
+
+    start_workers();
+  });
+}
diff --git a/retry.js b/retry.js
