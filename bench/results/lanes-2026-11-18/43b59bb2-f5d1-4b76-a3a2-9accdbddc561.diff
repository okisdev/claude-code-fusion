+++ b/retry.js
@@ -0,0 +1,20 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (attempts < 1) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "no attempts remaining"));
+  }
+  function run(remaining, delay) {
+    return Promise.resolve()
+      .then(operation)
+      .catch((failure) => {
+        if (remaining <= 1) {
+          const message = failure && failure.message !== undefined ? failure.message : String(failure);
+          throw app_error("RETRY_EXHAUSTED", message);
+        }
+        return delay_ms(delay).then(() => run(remaining - 1, delay * 2));
+      });
+  }
+  return run(attempts, base_delay_ms);
+}
