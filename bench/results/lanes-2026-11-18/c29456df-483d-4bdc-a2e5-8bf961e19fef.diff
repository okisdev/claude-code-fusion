index 0000000..cfa0bfe
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,23 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  const attempt_count = Math.floor(attempts);
+  if (!(attempt_count > 0)) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "No attempts were made"));
+  }
+
+  function run_attempt(remaining, delay) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((failure) => {
+        if (remaining === 1) {
+          throw app_error("RETRY_EXHAUSTED", failure?.message ?? String(failure));
+        }
+
+        return delay_ms(delay).then(() => run_attempt(remaining - 1, delay * 2));
+      });
+  }
+
+  return run_attempt(attempt_count, base_delay_ms);
+}
