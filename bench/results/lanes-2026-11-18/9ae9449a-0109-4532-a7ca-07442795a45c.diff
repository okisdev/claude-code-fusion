new file mode 100644
index 0000000..62d21b9
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,43 @@
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+  const results = new Array(items.length);
+  const worker_limit = limit >= 1 ? limit : 1;
+  let next_index = 0;
+  let running = 0;
+  let settled = false;
+  return new Promise((resolve, reject) => {
+    function launch() {
+      while (!settled && running < worker_limit && next_index < items.length) {
+        const index = next_index;
+        next_index += 1;
+        running += 1;
+        Promise.resolve()
+          .then(() => worker(items[index], index))
+          .then(
+            (value) => {
+              if (settled) {
+                return;
+              }
+              results[index] = value;
+              running -= 1;
+              if (next_index >= items.length && running === 0) {
+                settled = true;
+                resolve(results);
+              } else {
+                launch();
+              }
+            },
+            (error) => {
+              if (!settled) {
+                settled = true;
+                reject(error);
+              }
+            }
+          );
+      }
+    }
+    launch();
+  });
+}
diff --git a/retry.js b/retry.js
new file mode 100644
index 0000000..72128e2
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,32 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+function failure_message(error) {
+  if (error && typeof error.message === "string") {
+    return error.message;
+  }
+  return String(error);
+}
+
+function attempt(operation, attempts_left, delay) {
+  return Promise.resolve()
+    .then(() => operation())
+    .then(
+      (value) => value,
+      (error) => {
+        if (attempts_left <= 1) {
+          throw app_error("RETRY_EXHAUSTED", failure_message(error));
+        }
+        return delay_ms(delay).then(() =>
+          attempt(operation, attempts_left - 1, delay * 2)
+        );
+      }
+    );
+}
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (attempts < 1) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "no attempts"));
+  }
+  return attempt(operation, attempts, base_delay_ms);
+}
