index 0000000..508e28d
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,30 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  function failure_message(error) {
+    return error && error.message !== undefined ? error.message : String(error);
+  }
+
+  function run(attempt_index) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((error) => {
+        if (attempt_index + 1 >= attempts) {
+          return Promise.reject(
+            app_error("RETRY_EXHAUSTED", failure_message(error))
+          );
+        }
+        return delay_ms(base_delay_ms * Math.pow(2, attempt_index)).then(() =>
+          run(attempt_index + 1)
+        );
+      });
+  }
+
+  if (attempts <= 0) {
+    return Promise.reject(
+      app_error("RETRY_EXHAUSTED", "no attempts available")
+    );
+  }
+  return run(0);
+}
