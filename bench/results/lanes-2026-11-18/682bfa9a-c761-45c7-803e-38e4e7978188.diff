@@ -0,0 +1,42 @@
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+
+  const results = new Array(items.length);
+  let next_index = 0;
+  let first_error = null;
+
+  function run_next() {
+    if (first_error || next_index >= items.length) {
+      return Promise.resolve();
+    }
+    const index = next_index;
+    next_index += 1;
+    return Promise.resolve()
+      .then(() => worker(items[index], index))
+      .then(
+        (value) => {
+          results[index] = value;
+          return run_next();
+        },
+        (error) => {
+          if (first_error === null) {
+            first_error = error;
+          }
+        }
+      );
+  }
+
+  const slots = Math.min(Math.max(limit, 1), items.length);
+  const runners = [];
+  for (let i = 0; i < slots; i += 1) {
+    runners.push(run_next());
+  }
+  return Promise.all(runners).then(() => {
+    if (first_error !== null) {
+      return Promise.reject(first_error);
+    }
+    return results;
+  });
+}
diff --git a/retry.js b/retry.js
