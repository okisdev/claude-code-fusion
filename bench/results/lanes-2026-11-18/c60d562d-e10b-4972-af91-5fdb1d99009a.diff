@@ -0,0 +1,39 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  const count = items.length;
+  if (count === 0) {
+    return Promise.resolve([]);
+  }
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(app_error("INVALID_LIMIT", "Limit must be a positive integer."));
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(count);
+    let next_index = 0;
+    let remaining = count;
+
+    function run_next() {
+      const index = next_index++;
+      Promise.resolve()
+        .then(() => worker(items[index]))
+        .then((value) => {
+          results[index] = value;
+          remaining -= 1;
+          if (remaining === 0) {
+            resolve(results);
+          } else if (next_index < count) {
+            run_next();
+          }
+        }, (error) => {
+          next_index = count;
+          reject(error);
+        });
+    }
+
+    for (let i = 0; i < Math.min(limit, count); i++) {
+      run_next();
+    }
+  });
+}
