new file mode 100644
index 0000000..dbc9ab0
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,56 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(app_error("INVALID_CONCURRENCY_LIMIT", "Concurrency limit must be a positive integer"));
+  }
+
+  const results = new Array(items.length);
+  const worker_count = Math.min(limit, results.length);
+  let next_index = 0;
+  let remaining = results.length;
+  let failed = false;
+
+  return new Promise((resolve, reject) => {
+    function fail(error) {
+      failed = true;
+      reject(error);
+    }
+
+    function run_next() {
+      if (failed || next_index === results.length) {
+        return;
+      }
+
+      const index = next_index;
+      next_index += 1;
+
+      let result;
+      try {
+        result = worker(items[index]);
+      } catch (error) {
+        fail(error);
+        return;
+      }
+
+      Promise.resolve(result).then((value) => {
+        results[index] = value;
+        remaining -= 1;
+
+        if (remaining === 0) {
+          resolve(results);
+        } else {
+          run_next();
+        }
+      }, fail);
+    }
+
+    for (let slot = 0; slot < worker_count && !failed; slot += 1) {
+      run_next();
+    }
+  });
+}
