--- /dev/null
+++ b/retry.js
@@ -0,0 +1,22 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (!Number.isSafeInteger(attempts) || attempts < 1) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "Attempts must be a positive safe integer"));
+  }
+
+  function run_attempt(remaining, backoff_ms) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((error) => {
+        if (remaining === 1) {
+          throw app_error("RETRY_EXHAUSTED", error?.message ?? String(error));
+        }
+
+        return delay_ms(backoff_ms).then(() => run_attempt(remaining - 1, backoff_ms * 2));
+      });
+  }
+
+  return run_attempt(attempts, base_delay_ms);
+}
