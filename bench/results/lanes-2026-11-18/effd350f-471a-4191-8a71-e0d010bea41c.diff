diff --git a/duration-formatter/index.test.js b/duration-formatter/index.test.js
new file mode 100644
index 0000000..365367b
--- /dev/null
+++ b/duration-formatter/index.test.js
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { formatDuration } from "./index.js";
+
+test("formats completed minutes and remaining seconds", () => {
+  assert.equal(formatDuration(90), "1m 30s");
+  assert.equal(formatDuration(59), "59s");
+  assert.equal(formatDuration(60), "1m 0s");
+  assert.equal(formatDuration(119), "1m 59s");
+});
+
+test("truncates fractional seconds and clamps negative durations", () => {
+  assert.equal(formatDuration(60.9), "1m 0s");
+  assert.equal(formatDuration(-1), "0s");
+});
