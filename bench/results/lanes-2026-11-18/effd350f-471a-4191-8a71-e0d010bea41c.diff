diff --git a/path-matcher/index.test.js b/path-matcher/index.test.js
new file mode 100644
index 0000000..0f87e08
--- /dev/null
+++ b/path-matcher/index.test.js
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { matchesPath } from "./index.js";
+
+test("keeps a wildcard inside its path segment", () => {
+  assert.equal(matchesPath("src/*.js", "src/nested/main.js"), false);
+  assert.equal(matchesPath("src/*.js", "src/main.js"), true);
+  assert.equal(matchesPath("src/*.js", "src/.js"), true);
+  assert.equal(matchesPath("src/*/*.js", "src/nested/main.js"), true);
+});
+
+test("matches regular expression characters literally", () => {
+  assert.equal(matchesPath("src/[main].js", "src/[main].js"), true);
+  assert.equal(matchesPath("src/*.js", "src/mainXjs"), false);
+});
