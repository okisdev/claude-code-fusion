diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..b56cfba 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,38 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let fieldStart = 0;
+
+  while (fieldStart <= line.length) {
+    let openingQuote = fieldStart;
+    while (openingQuote < line.length && line[openingQuote].trim() === "") {
+      openingQuote += 1;
+    }
+
+    if (line[openingQuote] === '"') {
+      let closingQuote = line.indexOf('"', openingQuote + 1);
+      while (closingQuote !== -1 && line[closingQuote + 1] === '"') {
+        closingQuote = line.indexOf('"', closingQuote + 2);
+      }
+
+      if (closingQuote !== -1) {
+        let fieldEnd = closingQuote + 1;
+        while (fieldEnd < line.length && line[fieldEnd].trim() === "") {
+          fieldEnd += 1;
+        }
+
+        if (fieldEnd === line.length || line[fieldEnd] === ",") {
+          fields.push(line.slice(openingQuote + 1, closingQuote).replaceAll('""', '"'));
+          fieldStart = fieldEnd + 1;
+          continue;
+        }
+      }
+    }
+
+    const comma = line.indexOf(",", fieldStart);
+    const fieldEnd = comma === -1 ? line.length : comma;
+    fields.push(line.slice(fieldStart, fieldEnd).trim());
+    fieldStart = fieldEnd + 1;
+  }
+
+  return fields;
 }
diff --git a/csv-parser/index.test.js b/csv-parser/index.test.js
new file mode 100644
index 0000000..4dae374
--- /dev/null
+++ b/csv-parser/index.test.js
@@ -0,0 +1,14 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { parseCsvLine } from "./index.js";
+
+test("parses commas inside quoted fields", () => {
+  assert.deepEqual(parseCsvLine('team,"Park, Mina"'), ["team", "Park, Mina"]);
+  assert.deepEqual(parseCsvLine(' " a,""b"" " ,next'), [' a,"b" ', "next"]);
+});
+
+test("preserves empty fields and trims unquoted fields", () => {
+  assert.deepEqual(parseCsvLine(' , 6" pipe , ,'), ["", '6" pipe', "", ""]);
+  assert.deepEqual(parseCsvLine('""'), [""]);
+  assert.deepEqual(parseCsvLine(""), [""]);
+});
