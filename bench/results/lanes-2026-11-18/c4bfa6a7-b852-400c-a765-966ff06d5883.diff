--- /dev/null
+++ b/retry.js
@@ -0,0 +1,22 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (!Number.isSafeInteger(attempts) || attempts < 1) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "No valid retry attempts specified"));
+  }
+
+  function run_attempt(remaining, wait_ms) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((failure) => {
+        if (remaining === 1) {
+          throw app_error("RETRY_EXHAUSTED", failure?.message ?? String(failure));
+        }
+
+        return delay_ms(wait_ms).then(() => run_attempt(remaining - 1, wait_ms * 2));
+      });
+  }
+
+  return run_attempt(attempts, base_delay_ms);
+}
