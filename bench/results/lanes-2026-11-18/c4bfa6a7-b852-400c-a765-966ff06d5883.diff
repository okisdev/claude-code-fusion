index 0000000..b6146e5
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,47 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+  if (!Number.isInteger(limit) || limit < 1) {
+    return Promise.reject(app_error("INVALID_LIMIT", "limit must be a positive integer"));
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(items.length);
+    let next_index = 0;
+    let remaining = results.length;
+    let failed = false;
+
+    function run_next() {
+      if (failed || next_index === results.length) {
+        return;
+      }
+
+      const index = next_index++;
+      Promise.resolve()
+        .then(() => worker(items[index]))
+        .then(
+          (result) => {
+            results[index] = result;
+            remaining -= 1;
+            if (remaining === 0) {
+              resolve(results);
+            } else {
+              run_next();
+            }
+          },
+          (error) => {
+            failed = true;
+            reject(error);
+          },
+        );
+    }
+
+    const slots = Math.min(limit, results.length);
+    for (let slot = 0; slot < slots; slot += 1) {
+      run_next();
+    }
+  });
+}
