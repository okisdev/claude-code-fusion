+++ b/concurrent.js
@@ -0,0 +1,52 @@
+export function map_concurrent(items, limit, worker) {
+  return new Promise((resolve, reject) => {
+    if (items.length === 0) {
+      resolve([]);
+      return;
+    }
+
+    const results = new Array(items.length);
+    let next_index = 0;
+    let completed = 0;
+    let settled = false;
+
+    function run_next() {
+      if (settled || next_index >= items.length) {
+        return;
+      }
+
+      const index = next_index;
+      next_index += 1;
+
+      Promise.resolve()
+        .then(() => worker(items[index], index))
+        .then(
+          (result) => {
+            if (settled) {
+              return;
+            }
+            results[index] = result;
+            completed += 1;
+            if (completed === items.length) {
+              settled = true;
+              resolve(results);
+              return;
+            }
+            run_next();
+          },
+          (error) => {
+            if (settled) {
+              return;
+            }
+            settled = true;
+            reject(error);
+          },
+        );
+    }
+
+    const initial_workers = Math.min(limit, items.length);
+    for (let index = 0; index < initial_workers; index += 1) {
+      run_next();
+    }
+  });
+}
diff --git a/retry.js b/retry.js
