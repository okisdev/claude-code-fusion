diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..6d30a32 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,31 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let field = "";
+  let inQuotes = false;
+
+  for (let i = 0; i < line.length; i++) {
+    const character = line[i];
+    if (character === '"') {
+      if (inQuotes && line[i + 1] === '"') {
+        field += '""';
+        i++;
+      } else {
+        inQuotes = !inQuotes;
+        field += character;
+      }
+    } else if (character === "," && !inQuotes) {
+      fields.push(field);
+      field = "";
+    } else {
+      field += character;
+    }
+  }
+
+  fields.push(field);
+  return fields.map((rawField) => {
+    const trimmed = rawField.trim();
+    return trimmed.startsWith('"') && trimmed.endsWith('"')
+      ? trimmed.slice(1, -1).replaceAll('""', '"')
+      : trimmed;
+  });
 }
diff --git a/duration-formatter/index.js b/duration-formatter/index.js
