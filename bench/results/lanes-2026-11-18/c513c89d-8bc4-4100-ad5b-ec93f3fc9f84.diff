index 0000000..5285c45
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,17 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  function attempt(remaining, delay) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((error) => {
+        if (remaining <= 1) {
+          const message = error instanceof globalThis.Error ? error.message : String(error);
+          return Promise.reject(app_error("RETRY_EXHAUSTED", message));
+        }
+        return delay_ms(delay).then(() => attempt(remaining - 1, delay * 2));
+      });
+  }
+  return attempt(attempts, base_delay_ms);
+}
