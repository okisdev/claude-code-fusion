diff --git a/concurrent.js b/concurrent.js
new file mode 100644
index 0000000..b6702c2
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,53 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  return new Promise((resolve, reject) => {
+    if (items.length === 0) {
+      resolve([]);
+      return;
+    }
+    if (limit < 1) {
+      reject(app_error("INVALID_LIMIT", "limit must be at least 1"));
+      return;
+    }
+
+    const results = new Array(items.length);
+    let next_index = 0;
+    let running = 0;
+    let settled = false;
+
+    function launch() {
+      while (running < limit && next_index < items.length && !settled) {
+        const index = next_index;
+        next_index += 1;
+        running += 1;
+        Promise.resolve()
+          .then(() => worker(items[index]))
+          .then(
+            (value) => {
+              results[index] = value;
+              running -= 1;
+              if (settled) {
+                return;
+              }
+              if (next_index >= items.length && running === 0) {
+                settled = true;
+                resolve(results);
+              } else {
+                launch();
+              }
+            },
+            (error) => {
+              if (settled) {
+                return;
+              }
+              settled = true;
+              reject(error);
+            }
+          );
+      }
+    }
+
+    launch();
+  });
+}
diff --git a/retry.js b/retry.js
new file mode 100644
index 0000000..5310e5a
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,36 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+function failure_message(error) {
+  if (error && typeof error.message === "string") {
+    return error.message;
+  }
+  return String(error);
+}
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  function try_attempt(remaining, delay) {
+    return Promise.resolve()
+      .then(() => operation())
+      .then(
+        (value) => value,
+        (error) => {
+          if (remaining <= 1) {
+            return Promise.reject(
+              app_error("RETRY_EXHAUSTED", failure_message(error))
+            );
+          }
+          return delay_ms(delay).then(() =>
+            try_attempt(remaining - 1, delay * 2)
+          );
+        }
+      );
+  }
+
+  if (attempts < 1) {
+    return Promise.reject(
+      app_error("RETRY_EXHAUSTED", "no attempts remaining")
+    );
+  }
+  return try_attempt(attempts, base_delay_ms);
+}
