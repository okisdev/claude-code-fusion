@@ -0,0 +1,9 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { formatDuration } from "./index.js";
+
+test("only completed minutes count toward the minute portion", () => {
+  assert.equal(formatDuration(59.9), "59s");
+  assert.equal(formatDuration(60), "1m 0s");
+  assert.equal(formatDuration(90), "1m 30s");
+});
