diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..ea0b6d9 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,22 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  const quotedField = /\s*"((?:[^"]|"")*)"\s*(?=,|$)/y;
+  let start = 0;
+
+  while (start <= line.length) {
+    quotedField.lastIndex = start;
+    const match = quotedField.exec(line);
+    if (match) {
+      fields.push(match[1].replaceAll('""', '"'));
+      start = quotedField.lastIndex + 1;
+      continue;
+    }
+
+    const comma = line.indexOf(",", start);
+    const end = comma === -1 ? line.length : comma;
+    fields.push(line.slice(start, end).trim());
+    start = end + 1;
+  }
+
+  return fields;
 }
diff --git a/csv-parser/index.test.js b/csv-parser/index.test.js
new file mode 100644
index 0000000..d083ab6
--- /dev/null
+++ b/csv-parser/index.test.js
@@ -0,0 +1,8 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { parseCsvLine } from "./index.js";
+
+test("commas and escaped quotes inside quoted fields are data", () => {
+  assert.deepEqual(parseCsvLine('team,"Park, Mina"'), ["team", "Park, Mina"]);
+  assert.deepEqual(parseCsvLine('" a, ""b"" ", c ,,'), [' a, "b" ', "c", "", ""]);
+});
