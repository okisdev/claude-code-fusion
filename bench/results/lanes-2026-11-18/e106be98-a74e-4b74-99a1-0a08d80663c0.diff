index 0000000..a590128
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,22 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (!Number.isInteger(attempts) || attempts < 1) {
+    return Promise.reject(app_error("RETRY_EXHAUSTED", "Attempts must be a positive integer"));
+  }
+
+  function attempt(remaining, wait_ms) {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((failure) => {
+        if (remaining === 1) {
+          throw app_error("RETRY_EXHAUSTED", failure?.message ?? String(failure));
+        }
+
+        return delay_ms(wait_ms).then(() => attempt(remaining - 1, wait_ms * 2));
+      });
+  }
+
+  return attempt(attempts, base_delay_ms);
+}
