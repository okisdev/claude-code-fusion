diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..46daf49 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,26 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let field = "";
+  let inQuotes = false;
+
+  for (let index = 0; index < line.length; index += 1) {
+    const character = line[index];
+
+    if (character === '"') {
+      if (inQuotes && line[index + 1] === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        inQuotes = !inQuotes;
+      }
+    } else if (character === "," && !inQuotes) {
+      fields.push(field.trim());
+      field = "";
+    } else {
+      field += character;
+    }
+  }
+
+  fields.push(field.trim());
+  return fields;
 }
diff --git a/csv-parser/index.test.js b/csv-parser/index.test.js
new file mode 100644
index 0000000..f5bbf23
--- /dev/null
+++ b/csv-parser/index.test.js
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { parseCsvLine } from "./index.js";
+
+test("keeps quoted commas in their field", () => {
+  assert.deepEqual(parseCsvLine('team,"Park, Mina"'), ["team", "Park, Mina"]);
+  assert.deepEqual(parseCsvLine('"Park, Mina",team,"active, yes"'), [
+    "Park, Mina",
+    "team",
+    "active, yes",
+  ]);
+});
+
+test("decodes escaped double quotes within a quoted field", () => {
+  assert.deepEqual(parseCsvLine('team,"Park, ""Mina"""'), [
+    "team",
+    'Park, "Mina"',
+  ]);
+});
+
+test("preserves empty fields and trims surrounding whitespace", () => {
+  assert.deepEqual(parseCsvLine(" team , ,active,"), ["team", "", "active", ""]);
+  assert.deepEqual(parseCsvLine('"",team'), ["", "team"]);
+  assert.deepEqual(parseCsvLine(""), [""]);
+});
