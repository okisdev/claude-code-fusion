+++ b/duration-formatter/index.test.js
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { formatDuration } from "./index.js";
+
+test("uses completed minutes at minute and half-minute boundaries", () => {
+  for (const [seconds, expected] of [
+    [30, "30s"],
+    [59, "59s"],
+    [60, "1m 0s"],
+    [89, "1m 29s"],
+    [90, "1m 30s"],
+    [119, "1m 59s"],
+    [120, "2m 0s"],
+    [150, "2m 30s"],
+  ]) {
+    assert.equal(formatDuration(seconds), expected, `duration: ${seconds}`);
+  }
+});
+
+test("continues to clamp negative durations and truncate fractional seconds", () => {
+  assert.equal(formatDuration(-10), "0s");
+  assert.equal(formatDuration(0), "0s");
+  assert.equal(formatDuration(59.9), "59s");
+  assert.equal(formatDuration(90.9), "1m 30s");
+});
