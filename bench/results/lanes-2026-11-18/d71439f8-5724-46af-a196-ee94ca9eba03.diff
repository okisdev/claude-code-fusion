diff --git a/path-matcher/index.test.js b/path-matcher/index.test.js
new file mode 100644
index 0000000..3357b18
--- /dev/null
+++ b/path-matcher/index.test.js
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { matchesPath } from "./index.js";
+
+test("does not let wildcards cross a path separator", () => {
+  assert.equal(matchesPath("src/*.js", "src/nested/main.js"), false);
+  assert.equal(matchesPath("src/*.js", "src/nested/deep/main.js"), false);
+  assert.equal(matchesPath("src/*/main.js", "src/nested/deep/main.js"), false);
+});
+
+test("matches zero or more characters within one path segment", () => {
+  assert.equal(matchesPath("src/*.js", "src/main.js"), true);
+  assert.equal(matchesPath("src/*.js", "src/.js"), true);
+  assert.equal(matchesPath("src/*/main.js", "src/nested/main.js"), true);
+  assert.equal(matchesPath("src/m*n*.js", "src/main.js"), true);
+});
+
+test("keeps literal regular expression characters and full-path matching", () => {
+  assert.equal(matchesPath("src/*.js", "src/mainXjs"), false);
+  assert.equal(matchesPath("src/*.js", "src/main.js.bak"), false);
+  assert.equal(matchesPath("src/*.js", "other/src/main.js"), false);
+  assert.equal(matchesPath("src/[main]+(v1).js", "src/[main]+(v1).js"), true);
+  assert.equal(matchesPath("src/[main]+(v1).js", "src/mainv1.js"), false);
+});
