index 0000000..f5e0158
--- /dev/null
+++ b/retry.js
@@ -0,0 +1,30 @@
+import { app_error } from "./errors.js";
+import { delay_ms } from "./util.js";
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  if (!Number.isInteger(attempts) || attempts < 1) {
+    return Promise.reject(app_error("INVALID_ARGUMENT", "attempts must be a positive integer"));
+  }
+
+  if (!Number.isFinite(base_delay_ms) || base_delay_ms < 0) {
+    return Promise.reject(app_error("INVALID_ARGUMENT", "base_delay_ms must be a nonnegative number"));
+  }
+
+  let failures = 0;
+
+  function run() {
+    return Promise.resolve()
+      .then(() => operation())
+      .catch((error) => {
+        failures += 1;
+
+        if (failures === attempts) {
+          return Promise.reject(app_error("RETRY_EXHAUSTED", error?.message ?? String(error)));
+        }
+
+        return delay_ms(base_delay_ms * 2 ** (failures - 1)).then(run);
+      });
+  }
+
+  return run();
+}
