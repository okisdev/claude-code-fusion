diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..4115f37 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,61 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let field = "";
+  let inQuotes = false;
+  let quoted = false;
+  let quoteClosed = false;
+  let index = 0;
+
+  const finishField = () => {
+    fields.push(quoted ? field : field.trim());
+    field = "";
+    inQuotes = false;
+    quoted = false;
+    quoteClosed = false;
+  };
+
+  while (index < line.length) {
+    const char = line[index];
+
+    if (inQuotes) {
+      if (char === '"') {
+        if (line[index + 1] === '"') {
+          field += '"';
+          index += 2;
+        } else {
+          inQuotes = false;
+          quoteClosed = true;
+          index += 1;
+        }
+      } else {
+        field += char;
+        index += 1;
+      }
+      continue;
+    }
+
+    if (quoteClosed) {
+      if (char === ",") {
+        finishField();
+      } else if (!/\s/.test(char)) {
+        field += char;
+      }
+      index += 1;
+      continue;
+    }
+
+    if (char === ",") {
+      finishField();
+    } else if (char === '"' && field.trim() === "") {
+      field = "";
+      inQuotes = true;
+      quoted = true;
+    } else {
+      field += char;
+    }
+    index += 1;
+  }
+
+  finishField();
+  return fields;
 }
diff --git a/duration-formatter/index.js b/duration-formatter/index.js
