diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..4209850 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,14 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  const fieldPattern = /\s*"([^"]*(?:""[^"]*)*)"\s*(?=,|$)|[^,]*/y;
+  let start = 0;
+
+  while (start <= line.length) {
+    fieldPattern.lastIndex = start;
+    const [field, quotedContent] = fieldPattern.exec(line);
+    fields.push(quotedContent === undefined ? field.trim() : quotedContent.replaceAll('""', '"'));
+    start = fieldPattern.lastIndex + 1;
+  }
+
+  return fields;
 }
diff --git a/duration-formatter/index.js b/duration-formatter/index.js
