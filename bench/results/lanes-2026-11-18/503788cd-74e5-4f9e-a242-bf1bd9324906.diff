diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..ab13b78 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,28 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let fieldStart = 0;
+  let atFieldStart = true;
+  let inQuotes = false;
+
+  for (let index = 0; index <= line.length; index++) {
+    const character = line[index];
+    if (index === line.length || (character === "," && !inQuotes)) {
+      const field = line.slice(fieldStart, index).trim();
+      const quoted = !inQuotes && field.startsWith('"') && field.endsWith('"');
+      fields.push(quoted ? field.slice(1, -1).replaceAll('""', '"') : field);
+      fieldStart = index + 1;
+      atFieldStart = true;
+    } else if (character === '"' && (atFieldStart || inQuotes)) {
+      if (inQuotes && line[index + 1] === '"') {
+        index++;
+      } else {
+        inQuotes = !inQuotes;
+      }
+      atFieldStart = false;
+    } else if (atFieldStart) {
+      atFieldStart = character.trim() === "";
+    }
+  }
+
+  return fields;
 }
diff --git a/csv-parser/index.test.js b/csv-parser/index.test.js
new file mode 100644
index 0000000..3489d2b
--- /dev/null
+++ b/csv-parser/index.test.js
@@ -0,0 +1,20 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { parseCsvLine } from "./index.js";
+
+test("keeps a quoted comma in its field", () => {
+  assert.deepEqual(parseCsvLine('team,"Park, Mina"'), ["team", "Park, Mina"]);
+});
+
+test("decodes doubled quotes and preserves whitespace inside quotes", () => {
+  assert.deepEqual(parseCsvLine('  team , "  Park ""Mina"", Jr.  " ,'), [
+    "team",
+    '  Park "Mina", Jr.  ',
+    "",
+  ]);
+});
+
+test("preserves empty fields and literal quotes in unquoted fields", () => {
+  assert.deepEqual(parseCsvLine(""), [""]);
+  assert.deepEqual(parseCsvLine(',6",team,'), ["", '6"', "team", ""]);
+});
