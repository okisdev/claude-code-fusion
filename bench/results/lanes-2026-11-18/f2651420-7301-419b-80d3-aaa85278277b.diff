+++ b/retry.js
@@ -0,0 +1,20 @@
+import { app_error } from './errors.js';
+import { delay_ms } from './util.js';
+
+export function retry_with_backoff(operation, attempts, base_delay_ms) {
+  function run(attempt) {
+    return Promise.resolve().then(operation).catch((error) => {
+      if (attempt >= attempts) {
+        return Promise.reject(app_error('RETRY_EXHAUSTED', error?.message ?? String(error)));
+      }
+
+      return delay_ms(base_delay_ms * 2 ** (attempt - 1)).then(() => run(attempt + 1));
+    });
+  }
+
+  if (attempts <= 0) {
+    return Promise.reject(app_error('RETRY_EXHAUSTED', 'No attempts were made'));
+  }
+
+  return run(1);
+}
