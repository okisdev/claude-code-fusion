new file mode 100644
index 0000000..f5c71cc
--- /dev/null
+++ b/concurrent.js
@@ -0,0 +1,52 @@
+import { app_error } from "./errors.js";
+
+export function map_concurrent(items, limit, worker) {
+  if (items.length === 0) {
+    return Promise.resolve([]);
+  }
+
+  if (!Number.isInteger(limit) || limit <= 0) {
+    return Promise.reject(
+      app_error("INVALID_CONCURRENCY", "Concurrency limit must be a positive integer"),
+    );
+  }
+
+  return new Promise((resolve, reject) => {
+    const results = new Array(items.length);
+    let next_index = 0;
+    let completed = 0;
+    let failed = false;
+
+    function run_next() {
+      if (failed || next_index >= results.length) {
+        return;
+      }
+
+      const index = next_index;
+      next_index += 1;
+
+      Promise.resolve()
+        .then(() => worker(items[index]))
+        .then(
+          (result) => {
+            results[index] = result;
+            completed += 1;
+
+            if (completed === results.length) {
+              resolve(results);
+            } else {
+              run_next();
+            }
+          },
+          (error) => {
+            failed = true;
+            reject(error);
+          },
+        );
+    }
+
+    for (let index = 0; index < Math.min(limit, results.length); index += 1) {
+      run_next();
+    }
+  });
+}
diff --git a/retry.js b/retry.js
