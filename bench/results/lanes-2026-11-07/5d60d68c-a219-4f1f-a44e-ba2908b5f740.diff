diff --git a/format.js b/format.js
index f7d1562..bf0c774 100644
--- a/format.js
+++ b/format.js
@@ -2,10 +2,6 @@ function normalize(value) {
   return String(value).trim().replace(/\s+/g, " ");
 }
 
-export function formatWithCallback(value, callback) {
