diff --git a/alert.js b/alert.js
index 723a224..687913f 100644
--- a/alert.js
+++ b/alert.js
@@ -1,9 +1,6 @@
-import { formatWithCallback } from "./format.js";
+import { format } from "./format.js";
 
-export function buildAlert(message) {
-  return new Promise((resolve) => {
-    formatWithCallback(message, (value) => {
-      resolve(`Alert: ${value.toUpperCase()}`);
-    });
-  });
+export async function buildAlert(message) {
+  const value = await format(message);
+  return `Alert: ${value.toUpperCase()}`;
 }
