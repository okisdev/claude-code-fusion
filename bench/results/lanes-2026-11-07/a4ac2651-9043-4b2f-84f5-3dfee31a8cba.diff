diff --git a/csv-parser/index.js b/csv-parser/index.js
index 92cb4c1..75b240c 100644
--- a/csv-parser/index.js
+++ b/csv-parser/index.js
@@ -1,3 +1,27 @@
 export function parseCsvLine(line) {
-  return line.split(",").map((field) => field.trim());
+  const fields = [];
+  let current = "";
+  let inQuotes = false;
+
+  for (let i = 0; i < line.length; i++) {
+    const char = line[i];
+    if (char === '"') {
+      if (inQuotes && line[i + 1] === '"') {
+        current += '"';
+        i++;
+      } else {
+        inQuotes = !inQuotes;
+      }
+      continue;
+    }
+    if (char === "," && !inQuotes) {
+      fields.push(current.trim());
+      current = "";
+      continue;
+    }
+    current += char;
+  }
+
+  fields.push(current.trim());
+  return fields;
 }
diff --git a/duration-formatter/index.js b/duration-formatter/index.js
