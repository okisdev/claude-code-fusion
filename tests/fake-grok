#!/usr/bin/env node
(async () => {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const childProcess = await import("node:child_process");

  const argsFile = process.env.FAKE_GROK_ARGS_FILE;
  if (argsFile) {
    fs.appendFileSync(argsFile, JSON.stringify(process.argv.slice(2)) + "\n");
  }
  if (process.argv.includes("--version")) {
    process.stdout.write(`${process.env.FAKE_GROK_VERSION_OUTPUT ?? "grok 1.0.13 (0123456789ab)"}\n`);
    process.exit(0);
  }
  if (!process.env.GROK_HOME) {
    process.stderr.write("FAKE_GROK requires GROK_HOME under test.\n");
    process.exit(2);
  }
  const grokHome = path.resolve(process.cwd(), process.env.GROK_HOME);

  if (process.argv[2] === "doctor") {
    if (process.env.FAKE_GROK_DOCTOR_UNAVAILABLE === "1") {
      process.stderr.write("error: unrecognized subcommand 'doctor'\n");
      process.exit(2);
    }
    process.stdout.write("grok doctor: environment diagnostics\n");
    process.exit(0);
  }
  if (process.argv.includes("--help")) {
    const removedCapabilities = new Set(
      String(process.env.FAKE_GROK_REMOVED_CAPABILITIES ?? "")
        .split(",")
        .map((flag) => flag.trim())
        .filter(Boolean)
    );
    const removedFlag = [...removedCapabilities].find((flag) =>
      process.argv.slice(2).some((argument) => argument === flag || argument.startsWith(`${flag}=`))
    );
    if (removedFlag) {
      process.stderr.write(`error: unexpected argument '${removedFlag}'\n`);
      process.exit(2);
    }
    const hiddenCapabilities = new Set(
      String(process.env.FAKE_GROK_HIDDEN_CAPABILITIES ?? "")
        .split(",")
        .map((flag) => flag.trim())
        .filter(Boolean)
    );
    const capabilities = [
      "--prompt-file",
      "--output-format",
      "--sandbox",
      "--tools",
      "--disallowed-tools",
      "--deny",
      "--max-turns",
      "--no-auto-update",
      "--permission-mode",
      "--allow",
      "--disable-web-search",
      "--always-approve",
      "--no-subagents",
      "--no-wait-for-background",
      "--json-schema"
    ];
    process.stdout.write(`${capabilities.filter((flag) => !hiddenCapabilities.has(flag) && !removedCapabilities.has(flag)).join("\n")}\n`);
    process.exit(0);
  }
  if (process.env.FAKE_GROK_ENV_FILE) {
    const trackedEnv = Object.fromEntries(
      Object.entries(process.env)
        .filter(([key]) =>
          key.startsWith("CLAUDE_CODE_") ||
          key.startsWith("CLAUDE_PLUGIN_") ||
          key === "ANTHROPIC_API_KEY" ||
          key === "CODEX_API_KEY" ||
          key === "OPENAI_API_KEY" ||
          key === "XAI_API_KEY" ||
          key === "DATABASE_URL" ||
          key === "REDIS_URL" ||
          key === "SENTRY_DSN" ||
          key === "SSH_AUTH_SOCK" ||
          key === "GROK_CLAUDE_MARKER_OVERRIDE" ||
          key === "_GROK_CLAUDE_MARKER_OVERRIDE" ||
          key === "GROK_DISABLE_AUTOUPDATER" ||
          key === "GROK_MANAGED_MCPS_ENABLED" ||
          key === "GROK_MANAGED_MCP_GATEWAY_TOOLS_ENABLED" ||
          key === "GROK_WEB_FETCH" ||
          key === "GROK_TEST_VERSION" ||
          key === "GROK_SANDBOX" ||
          key === "GROK_LEADER_SOCKET" ||
          key === "GROK_AUTO_WAKE" ||
          key === "GROK_SUBAGENTS_MAX_DEPTH" ||
          key === "GROK_WEB_FETCH_PROXY" ||
          key === "GROK_WEB_FETCH_ALLOW_LOCAL" ||
          key === "GROK_COMPANION_CONTINUITY_POLICY" ||
          key === "GROK_MEMORY" ||
          key === "GROK_SUBAGENTS" ||
          key === "RUST_LOG" ||
          key === "TMPDIR" ||
          /^GROK_(?:CLAUDE|CURSOR|CODEX)_(?:SKILLS|RULES|AGENTS|MCPS|HOOKS|SESSIONS)_ENABLED$/.test(key)
        )
        .sort(([left], [right]) => left.localeCompare(right))
    );
    fs.writeFileSync(process.env.FAKE_GROK_ENV_FILE, `${JSON.stringify(trackedEnv, null, 2)}\n`, "utf8");
  }

  const mode = process.env.FAKE_GROK_MODE || "ok";
  if (mode === "sandbox-warning-ignore-term") {
    process.on("SIGTERM", () => {});
  }
  const sandboxIndex = process.argv.indexOf("--sandbox");
  const sandboxProfile = sandboxIndex >= 0 ? process.argv[sandboxIndex + 1] : null;
  if (sandboxProfile) {
    const sandboxEventDelayMs = Number(process.env.FAKE_GROK_SANDBOX_EVENT_DELAY_MS);
    if (Number.isFinite(sandboxEventDelayMs) && sandboxEventDelayMs > 0) {
      await new Promise((resolve) => setTimeout(resolve, sandboxEventDelayMs));
    }
    const eventFile = path.join(grokHome, "sandbox-events.jsonl");
    fs.mkdirSync(grokHome, { recursive: true });
    if (mode === "sandbox-log-rotate" && fs.existsSync(eventFile)) {
      fs.renameSync(eventFile, `${eventFile}.rotated`);
    }
    if (mode === "sandbox-log-truncate" && fs.existsSync(eventFile)) {
      fs.truncateSync(eventFile, 0);
      await new Promise((resolve) => setTimeout(resolve, 60));
    }
    const sandboxFailures = {
      "sandbox-warning": "Sandbox could not be applied, continuing without sandbox",
      "sandbox-unsupported-warning": "Sandbox not supported on this platform, continuing without sandbox",
      "sandbox-built-without-enforce-warning": "Sandbox enforcement unavailable (built without 'enforce' feature)",
      "sandbox-warning-ignore-term": "Sandbox could not be applied, continuing without sandbox"
    };
    let event = null;
    if (sandboxFailures[mode]) {
      event = {
        timestamp: new Date().toISOString(),
        event_type: "ApplyFailed",
        profile: sandboxProfile,
        workspace: fs.realpathSync(process.cwd()),
        enforced: false,
        error: sandboxFailures[mode]
      };
    } else if (mode !== "sandbox-no-event") {
      event = {
        timestamp: new Date().toISOString(),
        event_type: "ProfileApplied",
        profile: mode === "sandbox-event-wrong-profile" ? "workspace" : sandboxProfile,
        workspace: mode === "sandbox-event-wrong-workspace" ? path.dirname(fs.realpathSync(process.cwd())) : fs.realpathSync(process.cwd()),
        enforced: mode !== "sandbox-event-unenforced",
        restrict_network: mode === "sandbox-event-wrong-network" ? sandboxProfile === "workspace" : sandboxProfile !== "workspace",
        read_write_paths: mode === "sandbox-event-missing-tmpdir"
          ? [fs.realpathSync(process.cwd()), grokHome]
          : [fs.realpathSync(process.cwd()), grokHome, process.env.TMPDIR].filter(Boolean)
      };
    }
    if (event) {
      fs.appendFileSync(eventFile, `${JSON.stringify(event)}\n`, "utf8");
    }
    if (sandboxFailures[mode]) {
      process.stderr.write(`${sandboxFailures[mode]}\n`);
    }
  }
  let stdin = "";
  let stdinDrainTimedOut = false;
  let stdinDrainTimer = null;
  const stdinDrain = (async () => {
    try {
      for await (const chunk of process.stdin) {
        stdin += chunk.toString();
      }
    } catch (error) {
      if (!stdinDrainTimedOut) throw error;
    }
  })();
  let stdinClosed;
  try {
    stdinClosed = await Promise.race([
      stdinDrain.then(() => true),
      new Promise((resolve) => {
        stdinDrainTimer = setTimeout(() => resolve(false), 3000);
      }),
    ]);
  } finally {
    clearTimeout(stdinDrainTimer);
  }
  if (!stdinClosed) {
    stdinDrainTimedOut = true;
    process.stdin.destroy();
    await stdinDrain;
  }
  if (process.env.FAKE_GROK_STDIN_FILE) {
    fs.writeFileSync(process.env.FAKE_GROK_STDIN_FILE, stdin, "utf8");
  }
  if (process.env.FAKE_GROK_STDIN_LOG) {
    fs.appendFileSync(process.env.FAKE_GROK_STDIN_LOG, `${JSON.stringify(stdin)}\n`, "utf8");
  }
  if (process.env.FAKE_GROK_REJECT_EXTERNAL_PROMPT === "1") {
    const index = process.argv.indexOf("--prompt-file");
    const promptFile = index >= 0 ? process.argv[index + 1] : null;
    if (promptFile !== "/dev/stdin") {
      process.stderr.write(`Error:\nFailed to read '${promptFile}': Operation not permitted (os error 1)\n`);
      process.exit(1);
    }
  }
  const modeledToolIds = new Set([
    "read_file",
    "grep",
    "list_dir",
    "search_replace",
    "run_terminal_cmd",
    "web_search",
    "web_fetch",
    "Agent",
    "search_tool",
    "use_tool",
    "ask_user_question"
  ]);
  const disallowedToolIds = [];
  for (let index = 2; index < process.argv.length; index += 1) {
    const argument = process.argv[index];
    if (argument === "--disallowed-tools") {
      disallowedToolIds.push(process.argv[index + 1] ?? "");
      index += 1;
    } else if (argument.startsWith("--disallowed-tools=")) {
      disallowedToolIds.push(argument.slice("--disallowed-tools=".length));
    }
  }
  if (sandboxProfile && !new Set(["tool-allowlist-warning", "tool-disallowed-warning", "tool-policy-no-evidence"]).has(mode)) {
    process.stderr.write("DEBUG xai_grok_agent::builder: tools allowlist applied\n");
  }
  for (const toolId of disallowedToolIds.flatMap((value) => value.split(",").map((entry) => entry.trim()).filter(Boolean))) {
    if (!modeledToolIds.has(toolId)) {
      process.stderr.write(`WARN disallowedTools entry matched nothing agent=grok-test tool=${toolId}\n`);
    }
  }

  const reviewObject = {
    verdict: "needs-attention",
    findings: [
      {
        severity: "high",
        title: "Example finding",
        body: "Example body describing the defect.",
        file: "src/app.mjs",
        line_start: 10,
        line_end: 12,
        confidence: 0.9,
        recommendation: "Fix the defect before merging."
      }
    ],
    next_steps: ["Run the tests."]
  };
  const taskObject = {
    status: "completed",
    summary: "The requested task completed.",
    files: ["src/app.mjs"]
  };

  const emit = (envelope) => {
    if (envelope.sessionId && (process.env.FAKE_GROK_RESOLVED_MODEL || process.env.FAKE_GROK_RESOLVED_EFFORT)) {
      const encodedCwd = encodeURIComponent(process.cwd()).replace(/[!'()*]/g, (character) => `%${character.charCodeAt(0).toString(16).toUpperCase()}`);
      const sessionsRoot = path.join(grokHome, "sessions");
      const cwdDirectory = Buffer.byteLength(encodedCwd) <= 255
        ? encodedCwd
        : `fixture-${envelope.sessionId.slice(0, 16)}`;
      if (cwdDirectory !== encodedCwd) {
        fs.mkdirSync(path.join(sessionsRoot, cwdDirectory), { recursive: true });
        fs.writeFileSync(path.join(sessionsRoot, cwdDirectory, ".cwd"), process.cwd(), "utf8");
      }
      const summaryDir = path.join(sessionsRoot, cwdDirectory, envelope.sessionId);
      fs.mkdirSync(summaryDir, { recursive: true });
      fs.writeFileSync(path.join(summaryDir, "summary.json"), JSON.stringify({
        current_model_id: process.env.FAKE_GROK_RESOLVED_MODEL ?? null,
        reasoning_effort: process.env.FAKE_GROK_RESOLVED_EFFORT ?? null
      }));
    }
    process.stdout.write(JSON.stringify(envelope) + "\n");
  };

  const writeAllSync = (descriptor, value) => {
    const bytes = Buffer.from(value);
    let offset = 0;
    while (offset < bytes.length) {
      try {
        offset += fs.writeSync(descriptor, bytes, offset, bytes.length - offset);
      } catch (error) {
        if (error.code !== "EAGAIN") throw error;
        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 10);
      }
    }
  };

  const nextAttempt = () => {
    const counterFile = (argsFile || "fake-grok") + ".count";
    let count = 0;
    try {
      count = Number(fs.readFileSync(counterFile, "utf8")) || 0;
    } catch {}
    fs.writeFileSync(counterFile, String(count + 1));
    return count;
  };

  const usage = {
    input_tokens: 120,
    cache_read_input_tokens: 30,
    cache_creation_input_tokens: 0,
    output_tokens: 20,
    reasoning_tokens: 5,
    total_tokens: 170
  };
  const modelUsage = {
    "grok-test-main": {
      inputTokens: 100,
      outputTokens: 15,
      cacheReadInputTokens: 30,
      modelCalls: 2,
      costUSD: 0.01
    },
    "grok-test-subagent": {
      inputTokens: 20,
      outputTokens: 5,
      cacheReadInputTokens: 0,
      modelCalls: 1,
      costUSD: 0.002
    }
  };

  if (mode === "ok") {
    emit({
      text: "FAKE-OK",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111111",
      requestId: "req-1"
    });
    process.exit(0);
  }

  if (mode === "residual-process-group") {
    const descendant = childProcess.spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], {
      stdio: "ignore"
    });
    if (process.env.FAKE_GROK_DESCENDANT_PID_FILE) {
      fs.writeFileSync(process.env.FAKE_GROK_DESCENDANT_PID_FILE, JSON.stringify({ leader: process.pid, descendant: descendant.pid }), "utf8");
    }
    emit({
      text: "FAKE-RESIDUAL-PROCESS-GROUP",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111120",
      requestId: "req-residual-process-group"
    });
    process.exit(0);
  }

  if (mode === "malicious-session-id") {
    emit({
      text: "FAKE-MALICIOUS-SESSION",
      stopReason: "end_turn",
      sessionId: "../../attacker",
      requestId: "req-malicious-session",
      usage,
      modelUsage,
      num_turns: 2,
      usage_is_incomplete: true
    });
    process.exit(0);
  }

  if (mode === "usage-ok") {
    emit({
      text: "FAKE-USAGE-OK",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111112",
      requestId: "req-usage",
      usage,
      modelUsage
    });
    process.exit(0);
  }

  if (mode === "usage-incomplete-ok") {
    emit({
      text: "FAKE-USAGE-INCOMPLETE",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111113",
      requestId: "req-usage-incomplete",
      usage,
      modelUsage,
      usage_is_incomplete: true
    });
    process.exit(0);
  }

  if (mode === "usage-partial-unflagged") {
    emit({
      text: "FAKE-USAGE-PARTIAL",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111115",
      requestId: "req-usage-partial",
      usage: { input_tokens: 120, cache_creation_input_tokens: 0, output_tokens: 20 },
      modelUsage: { "grok-partial": { inputTokens: 120, outputTokens: 20 } }
    });
    process.exit(0);
  }

  if (mode === "metrics-complete") {
    emit({
      text: "FAKE-METRICS-COMPLETE",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111116",
      requestId: "req-metrics-complete",
      usage,
      modelUsage: {
        "grok-test-main": {
          inputTokens: 120,
          outputTokens: 20,
          cacheReadInputTokens: 30,
          reasoningTokens: 5,
          totalTokens: 170,
          modelCalls: 3,
          costUSD: 0.012
        }
      },
      num_turns: 3,
      total_cost_usd: 0.012,
      total_cost_usd_ticks: 120000000,
      cost_is_partial: false,
      usage_is_incomplete: false,
      structuredOutput: {
        status: "completed",
        summary: "The requested work completed.",
        changedFiles: [],
        verification: ["fake verification"],
        blockers: []
      }
    });
    process.exit(0);
  }

  if (mode === "usage-cache-creation") {
    emit({
      text: "FAKE-USAGE-CACHE-CREATION",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111122",
      requestId: "req-usage-cache-creation",
      usage: { ...usage, cache_creation_input_tokens: 10, total_tokens: 180 },
      modelUsage
    });
    process.exit(0);
  }

  const invalidMetricEnvelopes = {
    "metrics-fractional-turns": { num_turns: 1.5 },
    "metrics-lone-cost": { total_cost_usd_ticks: 120000000 },
    "metrics-inconsistent-cost": { total_cost_usd: 0.013, total_cost_usd_ticks: 120000000 },
    "metrics-incomplete-cost": { total_cost_usd: 0.012, total_cost_usd_ticks: 120000000, usage_is_incomplete: true }
  };
  if (invalidMetricEnvelopes[mode]) {
    emit({
      text: "FAKE-INVALID-METRICS",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111119",
      requestId: `req-${mode}`,
      ...invalidMetricEnvelopes[mode]
    });
    process.exit(0);
  }

  const malformedSpendEnvelopes = {
    "metrics-usage-array": { usage: [], modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-negative-token": { usage: { ...usage, output_tokens: -1 }, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-fractional-token": { usage: { ...usage, output_tokens: 20.5, total_tokens: 170.5 }, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-unsafe-token": { usage: { ...usage, input_tokens: 9007199254740992 }, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-conflicting-flags": { usage, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000, usage_is_incomplete: false, usageIsIncomplete: true },
    "metrics-conflicting-token-aliases": { usage: { ...usage, outputTokens: 21 }, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-reasoning-exceeds-output": { usage: { ...usage, reasoning_tokens: 21 }, modelUsage, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 },
    "metrics-malformed-model": { usage, modelUsage: { "grok-test-main": { inputTokens: 120, outputTokens: "20", cacheReadInputTokens: 30, modelCalls: 3 } }, total_cost_usd: 0.012, total_cost_usd_ticks: 120000000 }
  };
  if (malformedSpendEnvelopes[mode]) {
    emit({
      text: "FAKE-MALFORMED-SPEND",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111121",
      requestId: `req-${mode}`,
      ...malformedSpendEnvelopes[mode]
    });
    process.exit(0);
  }

  if (mode === "large-stdout-json") {
    writeAllSync(1, `${JSON.stringify({
      text: `large-output-begins:${"x".repeat(1536 * 1024)}:large-output-ends`,
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111117",
      requestId: "req-large-stdout"
    })}\n`);
    process.exit(0);
  }

  if (mode === "sandbox-warning") {
    process.stderr.write("Sandbox could not be applied, continuing without sandbox\n");
    setTimeout(() => {
      if (process.env.FAKE_GROK_SANDBOX_SENTINEL) {
        fs.writeFileSync(process.env.FAKE_GROK_SANDBOX_SENTINEL, "unsandboxed activity\n", "utf8");
      }
      emit({
        text: "UNSANDBOXED",
        stopReason: "end_turn",
        sessionId: "11111111-1111-7111-8111-111111111114",
        requestId: "req-sandbox-warning"
      });
      process.exit(0);
    }, 1000);
    return;
  }

  const safetyWarnings = {
    "sandbox-unsupported-warning": "Sandbox not supported on this platform, continuing without sandbox",
    "sandbox-built-without-enforce-warning": "Sandbox enforcement unavailable (built without 'enforce' feature)",
    "tool-allowlist-warning": "tools allowlist had unmappable entries; keeping full grok toolset",
    "tool-disallowed-warning": "disallowedTools entry matched nothing"
  };
  if (safetyWarnings[mode]) {
    process.stderr.write(`${safetyWarnings[mode]}\n`);
    setTimeout(() => {
      if (process.env.FAKE_GROK_SANDBOX_SENTINEL) {
        fs.writeFileSync(process.env.FAKE_GROK_SANDBOX_SENTINEL, "unsafe activity\n", "utf8");
      }
      emit({
        text: "UNSAFE",
        stopReason: "end_turn",
        sessionId: "11111111-1111-7111-8111-111111111118",
        requestId: "req-safety-warning"
      });
      process.exit(0);
    }, 1000);
    return;
  }

  if (mode === "tool-policy-no-evidence") {
    emit({
      text: "UNVERIFIED-POLICY",
      stopReason: "end_turn",
      sessionId: "11111111-1111-7111-8111-111111111119",
      requestId: "req-unverified-policy"
    });
    process.exit(0);
  }

  if (mode === "review-ok") {
    emit({
      text: "```json\n" + JSON.stringify(reviewObject) + "\n```",
      ...(process.argv.includes("--json-schema") ? { structuredOutput: reviewObject } : {}),
      stopReason: "end_turn",
      sessionId: "33333333-3333-7333-8333-333333333333",
      requestId: "req-1"
    });
    process.exit(0);
  }

  if (mode === "task-structured-success") {
    emit({
      text: "The requested task completed.",
      structuredOutput: taskObject,
      stopReason: "end_turn",
      sessionId: "55555555-5555-7555-8555-555555555555",
      requestId: "req-task-structured-success"
    });
    process.exit(0);
  }

  if (mode === "task-structured-error") {
    emit({
      text: JSON.stringify(taskObject),
      structuredOutput: null,
      structuredOutputError: "output does not match the requested schema",
      stopReason: "end_turn",
      sessionId: "56565656-5656-7565-8565-565656565656",
      requestId: "req-task-structured-error"
    });
    process.exit(0);
  }

  if (mode === "task-structured-null") {
    emit({
      text: JSON.stringify(taskObject),
      structuredOutput: null,
      stopReason: "end_turn",
      sessionId: "57575757-5757-7575-8575-575757575757",
      requestId: "req-task-structured-null"
    });
    process.exit(0);
  }

  if (mode === "task-structured-absent") {
    emit({
      text: `Here is the result:\n\`\`\`json\n${JSON.stringify(taskObject)}\n\`\`\``,
      stopReason: "end_turn",
      sessionId: "58585858-5858-7585-8585-585858585858",
      requestId: "req-task-structured-absent"
    });
    process.exit(0);
  }

  if (mode === "badjson-then-ok") {
    const count = nextAttempt();
    if (count === 0) {
      emit({
        text: "```markdown\nI could not produce the requested object, sorry.\n```",
        stopReason: "end_turn",
        sessionId: "22222222-2222-7222-8222-222222222222",
        requestId: "req-1"
      });
    } else {
      emit({
        text: "```json\n" + JSON.stringify(reviewObject) + "\n```",
        stopReason: "end_turn",
        sessionId: "22222222-2222-7222-8222-222222222222",
        requestId: "req-2"
      });
    }
    process.exit(0);
  }

  const reviewUsageModes = new Set([
    "review-usage-complete-complete",
    "review-usage-complete-partial",
    "review-usage-partial-complete",
    "review-usage-complementary-partials"
  ]);
  if (reviewUsageModes.has(mode)) {
    const completeUsageA = {
      input_tokens: 10,
      cache_read_input_tokens: 2,
      cache_creation_input_tokens: 0,
      output_tokens: 3,
      reasoning_tokens: 1,
      total_tokens: 15
    };
    const completeUsageB = {
