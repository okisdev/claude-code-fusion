#!/usr/bin/env node
(async () => {
  const fs = await import("node:fs");
  const path = await import("node:path");

  const args = process.argv.slice(2);
  const mode = process.env.FAKE_CLAUDE_MODE || "ok";
  const configDir = process.env.CLAUDE_CONFIG_DIR;
  if (!configDir) {
    process.stderr.write("CLAUDE_CONFIG_DIR is required.\n");
    process.exit(2);
  }

  let outputFormat = "text";
  let prompt = "";
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === "--output-format") {
      outputFormat = args[index + 1] ?? "";
      index += 1;
      continue;
    }
    if (arg === "-p" || arg === "--print") {
      continue;
    }
    if (!arg.startsWith("-") && !prompt) {
      prompt = arg;
    }
  }

  const cwd = process.cwd();
  const sessionId = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
  const slug = cwd.replace(/[^A-Za-z0-9._-]/g, "-");
  const projectDir = path.join(configDir, "projects", slug);
  const transcriptFile = path.join(projectDir, `${sessionId}.jsonl`);
  const runRecord = {
    args,
    prompt,
    outputFormat,
    cwd,
    sawVerify: fs.existsSync(path.join(cwd, "verify.sh"))
  };
  if (process.env.FAKE_CLAUDE_RUNS_FILE) {
    fs.appendFileSync(process.env.FAKE_CLAUDE_RUNS_FILE, `${JSON.stringify(runRecord)}\n`, "utf8");
  }

  const writeTranscript = () => {
    fs.mkdirSync(projectDir, { recursive: true });
    const records = [
      {
        type: "assistant",
        message: {
          role: "assistant",
          model: "claude-sonnet-4-5",
          content: [
            {
              type: "tool_use",
              id: "toolu_agent",
              name: "Agent",
              input: { prompt: "delegate part of the task" }
            }
          ],
          usage: {
            input_tokens: 100,
            output_tokens: 40,
            cache_read_input_tokens: 10,
            cache_creation_input_tokens: 5
          }
        }
      },
      {
        type: "assistant",
        message: {
          role: "assistant",
          model: "claude-sonnet-4-5",
          content: [{ type: "text", text: "done" }],
          usage: {
            input_tokens: 30,
            output_tokens: 12,
            cache_read_input_tokens: 3,
            cache_creation_input_tokens: 1
          }
        }
      },
      {
        type: "assistant",
        isSidechain: true,
        message: {
          role: "assistant",
          model: "claude-haiku-4-5",
          content: [{ type: "text", text: "subagent result" }],
          usage: {
            input_tokens: 50,
            output_tokens: 20,
            cache_read_input_tokens: 4,
            cache_creation_input_tokens: 2
          }
        }
      }
    ];
    fs.writeFileSync(transcriptFile, records.map((record) => JSON.stringify(record)).join("\n") + "\n", "utf8");
  };

  const emit = (subtype) => {
    process.stdout.write(
      JSON.stringify({
        type: "result",
        subtype,
        session_id: sessionId,
        sessionId,
        model: "claude-opus-4-1",
        usage: {
          input_tokens: 7,
          output_tokens: 3,
          cache_read_input_tokens: 1,
          cache_creation_input_tokens: 0
        },
        result: "fake result"
      }) + "\n",
    );
  };

  if (mode === "ok") {
    fs.writeFileSync(path.join(cwd, "marker.txt"), "fake claude completed\n", "utf8");
    writeTranscript();
    emit("success");
    process.exit(0);
  }

  if (mode === "no-transcript") {
    fs.writeFileSync(path.join(cwd, "marker.txt"), "fake claude completed\n", "utf8");
    emit("success");
    process.exit(0);
  }

  if (mode === "fail") {
    writeTranscript();
    emit("error");
    process.stderr.write("Fake Claude failed on purpose.\n");
    process.exit(1);
  }

  process.stderr.write("Unknown FAKE_CLAUDE_MODE: " + mode + "\n");
  process.exit(2);
})();
